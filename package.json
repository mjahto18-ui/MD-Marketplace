{
  "name": "md-marketplace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "install-graph": "npm install --save-dev dependency-cruiser madge",
    "draw-graph": "depcruise app --include-only \"^app\" --output-type dot | dot -T svg > public/md-architecture-graph.svg",
    "draw-graph:png": "depcruise app --include-only \"^app\" --output-type dot | dot -T png > public/md-architecture-graph.png",
    "check-circular": "madge --circular --extensions js,jsx,ts,tsx app/"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@zxing/library": "^0.21.3",
    "googleapis": "^144.0.0",
    "jimp": "^0.22.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "dependency-cruiser": "^16.6.0",
    "madge": "^8.0.0"
  }
}
